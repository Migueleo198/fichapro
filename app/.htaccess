# Código de la aplicación: sin acceso web directo.
# La app accede a estos ficheros por el sistema de archivos (require),
# nunca por HTTP, así que bloquearlos no rompe nada.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
