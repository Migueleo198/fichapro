# ── FichaPro · plantilla de configuración ───────────────────────────
# Copia este archivo a .env y rellena los valores. NO subas el .env al repo.
#   cp .env.example .env

# App
APP_NAME=FichaPro
URL_BASE=/fichapro/public
APP_URL=http://localhost/fichapro/public

# Base de datos (usuario dedicado con contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fichapro
DB_USER=fichapro
DB_PASS=

# Valores de negocio por defecto
DEF_HORAS_DIA=7.5
DEF_HORAS_SEMANA=37.5
DEF_UMBRAL_RETRASO=30
DEF_HORA_INICIO=08:00

# SMTP (para informes por correo). Con Gmail usa una contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=FichaPro
